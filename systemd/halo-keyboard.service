[Unit]
Description=Lenovo Yoga Book Halo keyboard handler
Documentation=man:halo-keyboard-handler(8)
ConditionPathExists=/dev/halo_keyboard

[Service]
Type=simple
ExecStart=/usr/sbin/halo-keyboard-handler --config-directory /etc/halo-keyboard -m 1.0 -D 6
Restart=on-failure
RestartSec=1s
KillMode=control-group
NoNewPrivileges=true
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true
PrivateTmp=true
ProtectHome=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RemoveIPC=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
