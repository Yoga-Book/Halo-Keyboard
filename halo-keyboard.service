[Unit]
Description=Lenovo Yoga Book Halo keyboard handler
Documentation=man:halo-keyboard-handler(8)
ConditionPathExists=/dev/halo_keyboard

[Service]
Type=simple
WorkingDirectory=/etc/halo-keyboard
ExecStart=/usr/sbin/halo-keyboard-handler -m 1.0 -D 6
Restart=on-failure
RestartSec=1s
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
